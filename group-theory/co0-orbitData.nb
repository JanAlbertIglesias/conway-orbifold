Cell[BoxData[
 RowBox[{
  RowBox[{"realOrbits", "=", 
   RowBox[{"Complement", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{"i", ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"Length", "[", "SL2ZOrbits", "]"}]}], "}"}]}], "]"}], ",", 
     "cpxOrbits"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9858140150382557`*^9, 3.9858140855813293`*^9}},
 CellLabel->"In[63]:=",ExpressionUUID->"4bce03c7-df04-47e8-8479-4cceb0600fd4"],

