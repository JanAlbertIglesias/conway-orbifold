Notebook[{
Cell[BoxData[
 RowBox[{
  RowBox[{"SetDirectory", "[", 
   RowBox[{"NotebookDirectory", "[", "]"}], "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.986195213133245*^9, 3.986195221684208*^9}},
 CellLabel->"In[69]:=",ExpressionUUID->"39d25d2b-2f36-4320-a1f1-6c08ecac8b02"],

Cell[BoxData[
 RowBox[{
  RowBox[{"check", "[", 
   RowBox[{"{", 
    RowBox[{"x_", ",", "y_"}], "}"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"v", "=", 
       RowBox[{"abelianOrders", "[", 
        RowBox[{"[", 
         RowBox[{"x", ",", "y"}], "]"}], "]"}]}], ",", "a", ",", "b", ",", 
      "c"}], "}"}], ",", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"a", ",", "b", ",", "c"}], "}"}], "=", "v"}], ";", 
     RowBox[{
      RowBox[{"IntegerQ", "[", 
       RowBox[{"b", "/", "a"}], "]"}], " ", "&&", " ", 
      RowBox[{"c", "==", 
       RowBox[{"a", " ", "b"}]}]}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.986167897268903*^9, 3.9861679603258743`*^9}},
 CellLabel->"In[43]:=",ExpressionUUID->"fcb805e6-c690-4820-9457-cc9be19fd9be"],

Cell[BoxData[
 RowBox[{
  RowBox[{"<<", "\"\<../data/co0abelianOrders.m\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.999246053083706*^9, 3.999246103925477*^9}},
 CellLabel->"In[47]:=",ExpressionUUID->"3824962d-dec6-406d-a7b5-9eedb9c7c9c0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"<<", "\"\<../data/co0orbits.m\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.999246098009184*^9, 3.999246102622333*^9}},
 CellLabel->"In[48]:=",ExpressionUUID->"35f2f6bd-feb4-4afe-8d24-9c258bd10040"],

Cell[BoxData[
 RowBox[{
  RowBox[{"<<", "\"\<../data/co0actions.m\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.9992468372595167`*^9, 3.999246839152227*^9}},
 CellLabel->"In[55]:=",ExpressionUUID->"8f639394-6cc8-4a00-bdbd-5724c0c85d27"],

Cell[BoxData[
 RowBox[{
  RowBox[{"goodOrbitRepIndex", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"FirstPosition", "[", 
       RowBox[{
        RowBox[{"check", "/@", 
         RowBox[{"SL2ZOrbits", "[", 
          RowBox[{"[", "i", "]"}], "]"}]}], ",", "True"}], "]"}], "[", 
      RowBox[{"[", "1", "]"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", 
       RowBox[{"Length", "[", "SL2ZOrbits", "]"}]}], "}"}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{3.9992461154436197`*^9},
 CellLabel->"In[49]:=",ExpressionUUID->"27ce23d7-4d2f-4fda-9398-7cc69c7a1316"],

Cell["\<\
pacOnOrbit  computes the action of [g,h] \[Rule] [g,h^{-1}] at the level of \
SL2Z orbits. A real orbit is mapped by pacOnOrbit to itself; complex orbits \
form pairs. cpxOrbits is the list of complex orbits\
\>", "Text",
 CellChangeTimes->{{3.98590604434708*^9, 
  3.985906147575597*^9}},ExpressionUUID->"06e761a6-d100-471f-a191-\
bbebffdb3ec2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"pac", "[", 
   RowBox[{"{", 
    RowBox[{"i_", ",", "j_"}], "}"}], "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{"i", ",", 
    RowBox[{"paction", "[", 
     RowBox[{"[", 
      RowBox[{"i", ",", "j"}], "]"}], "]"}]}], "}"}]}]], "Input",
 CellChangeTimes->{{3.967665313474564*^9, 3.967665329734018*^9}},
 CellLabel->"In[56]:=",ExpressionUUID->"2c73439b-5062-4a5c-9216-dbefdf4aa20d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"pacOnOrbit", "[", "i_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"x", "=", 
      RowBox[{"pac", "[", 
       RowBox[{"SL2ZOrbits", "[", 
        RowBox[{"[", 
         RowBox[{"i", ",", "1"}], "]"}], "]"}], "]"}]}], "}"}], ",", 
    RowBox[{
     RowBox[{"FirstPosition", "[", 
      RowBox[{"SL2ZOrbits", ",", 
       RowBox[{"y_", "/;", 
        RowBox[{"MemberQ", "[", 
         RowBox[{"y", ",", "x"}], "]"}]}]}], "]"}], "[", 
     RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.967665410428236*^9, 3.967665473152878*^9}, {
  3.967665510935492*^9, 3.96766553056991*^9}, {3.96766560253325*^9, 
  3.967665607618859*^9}, {3.967665650798772*^9, 3.9676656700124807`*^9}, {
  3.967665733235922*^9, 3.9676657350902977`*^9}, {3.967665932716845*^9, 
  3.967665945465188*^9}, {3.96766598591861*^9, 3.967665986337518*^9}, {
  3.967968508924505*^9, 3.967968521234277*^9}, {3.98530190244724*^9, 
  3.98530191089289*^9}, {3.985811979659061*^9, 3.9858119839935513`*^9}},
 CellLabel->"In[57]:=",ExpressionUUID->"9c9fa854-d681-4a43-8eca-95368f8a6135"],

Cell[BoxData[
 RowBox[{
  RowBox[{"pacOnOrbitResult", "=", 
   RowBox[{"pacOnOrbit", "/@", 
    RowBox[{"Table", "[", 
     RowBox[{"i", ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", 
        RowBox[{"SL2ZOrbits", "//", "Length"}]}], "}"}]}], "]"}]}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.985301921423997*^9, 3.9853019275254498`*^9}, {
  3.985318616265224*^9, 3.985318621161744*^9}, {3.985393318646103*^9, 
