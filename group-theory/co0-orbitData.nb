 CellLabel->"In[58]:=",ExpressionUUID->"b27f3473-960b-46db-88e6-c0c9c48f1f5c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"cpxOrbits", "=", 
   RowBox[{"Select", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{"i", ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"SL2ZOrbits", "//", "Length"}]}], "}"}]}], "]"}], ",", 
     RowBox[{
      RowBox[{"#", "!=", 
       RowBox[{"pacOnOrbitResult", "[", 
        RowBox[{"[", "#", "]"}], " ", "]"}]}], "&"}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.985301950674464*^9, 3.985301952877602*^9}, {
  3.985310391345834*^9, 3.985310394883789*^9}, {3.98539332419269*^9, 
