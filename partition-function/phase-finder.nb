Cell[BoxData[
 RowBox[{
  RowBox[{"genEqsAB", "[", 
   RowBox[{"g_", ",", "func_"}], "]"}], ":=", 
  RowBox[{"Catch", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"message", "=", 
     RowBox[{"\"\<generating eqs with \>\"", "<>", 
      RowBox[{"ToString", "[", "func", "]"}]}]}], ";", 
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", "Ng\[Chi]", "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Ng\[Chi]", "=", 
          RowBox[{
           RowBox[{"func", "[", 
            RowBox[{"g", ",", "\[Chi]"}], "]"}], "//", "RootReduce"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", " ", 
          RowBox[{
           RowBox[{
            RowBox[{
            "If", " ", "we", " ", "detect", " ", "a", " ", "B", " ", "in", 
             " ", "this", " ", "g"}], "-", "sector"}], ",", " ", 
           RowBox[{
           "we", " ", "move", " ", "on", " ", "to", " ", "the", " ", "next", 
            " ", "one"}]}], " ", "*)"}], "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"!", 
             RowBox[{"FreeQ", "[", 
              RowBox[{"Ng\[Chi]", ",", "_A"}], "]"}]}], "||", 
            RowBox[{"!", 
             RowBox[{"FreeQ", "[", 
              RowBox[{"Ng\[Chi]", ",", "_B"}], "]"}]}]}], ",", 
           RowBox[{"PrependTo", "[", 
            RowBox[{"eqsA", ",", "Ng\[Chi]"}], "]"}]}], "]"}]}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Chi]", ",", 
        RowBox[{"Length", "[", 
         RowBox[{"sizes", "[", 
          RowBox[{"[", "g", "]"}], "]"}], "]"}]}], "}"}]}], "]"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[55]:=",ExpressionUUID->"d265b4e9-a3ab-43f2-8598-840717816b2f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MaxVar", "=", "10"}], ";"}]], "Input",
 CellLabel->"In[56]:=",ExpressionUUID->"60952b2a-c2cc-4ccd-b5e0-31caaea34c59"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Bcases", "[", "orb_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "aorder", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"aorder", "=", 
       RowBox[{
        RowBox[{"Extract", "[", 
         RowBox[{"abelianOrders", ",", 
          RowBox[{"betterOrbitRep", "[", 
           RowBox[{"[", "orb", "]"}], "]"}]}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"B", "[", "orb", "]"}], "->", 
           RowBox[{"Exp", "[", 
            RowBox[{"2", "\[Pi]", " ", "I", " ", 
             FractionBox["n", 
              RowBox[{"2", "aorder"}]]}], "]"}]}], ",", 
          RowBox[{
           RowBox[{"BB", "[", "orb", "]"}], "->", 
           RowBox[{"Exp", "[", 
            RowBox[{
             RowBox[{"-", "2"}], "\[Pi]", " ", "I", " ", 
             FractionBox["n", 
              RowBox[{"2", "aorder"}]]}], "]"}]}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"n", ",", "0", ",", 
          RowBox[{
           RowBox[{"2", "aorder"}], "-", "1"}]}], "}"}]}], "]"}]}]}], "]"}]}],
   ";"}]], "Input",
 CellLabel->"In[57]:=",ExpressionUUID->"9995b6d9-8490-43b2-b3c9-6e5c33f73a7b"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"TryFixAB", "[", "]"}], ":=", 
   RowBox[{"While", "[", 
    RowBox[{"True", ",", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "pos", ",", "checks", ",", "integers", ",", "vars", ",", "Aoptions", 
         ",", "result", ",", "Borbits", ",", "CombOptions"}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{"What", " ", "variables", " ", 
         RowBox[{"remain", "?"}]}], " ", "*)"}], 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"eqsA", "==", 
           RowBox[{"{", "}"}]}], ",", 
          RowBox[{"Break", "[", "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"vars", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"eqsA", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "//", "Variables"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", 
             RowBox[{"Length", "[", "eqsA", "]"}]}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
         "Pick", " ", "the", " ", "first", " ", "with", " ", "fewer", " ", 
          "variables"}], " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"pos", "=", 
         RowBox[{
          RowBox[{"PositionSmallest", "[", 
           RowBox[{
            RowBox[{"Length", "/@", "vars"}], "/.", " ", 
            RowBox[{"0", "->", "Infinity"}]}], "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
         "Exit", " ", "loop", " ", "if", " ", "all", " ", "equations", " ", 
          "are", " ", "empty"}], " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"vars", "[", 
            RowBox[{"[", "pos", "]"}], "]"}], "==", 
           RowBox[{"{", "}"}]}], ",", 
          RowBox[{
           RowBox[{"message", "=", "\"\<Done!!\>\""}], ";", 
           RowBox[{"Break", "[", "]"}], ";"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
          RowBox[{"Simplify", " ", 
           RowBox[{"equation", ".", " ", "If"}], " ", 
           RowBox[{"it", "'"}], "s", " ", "trivial"}], ",", " ", 
          RowBox[{"delete", " ", "and", " ", "move", " ", 
           RowBox[{"on", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"eqsA", "[", 
             RowBox[{"[", "pos", "]"}], "]"}], "==", "0"}], "//", 
           "Simplify"}], ",", 
          RowBox[{
           RowBox[{"eqsA", "=", 
            RowBox[{"Delete", "[", 
             RowBox[{"eqsA", ",", "pos"}], "]"}]}], ";", 
           RowBox[{"Continue", "[", "]"}], ";"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
          RowBox[{"Test", " ", "the"}], " ", "+", 
          RowBox[{
           RowBox[{"-", "1"}], " ", "options"}]}], " ", "*)"}], 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"\"\<num vars:\>\"", ",", 
            RowBox[{"Length", "@", 
             RowBox[{"vars", "[", 
              RowBox[{"[", "pos", "]"}], "]"}]}]}], "]"}], ";"}], "*)"}], 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "@", 
            RowBox[{"vars", "[", 
             RowBox[{"[", "pos", "]"}], "]"}]}], ">", "MaxVar"}], ",", 
          RowBox[{
           RowBox[{"AppendTo", "[", 
            RowBox[{"bckpeqs", ",", 
             RowBox[{"eqsA", "[", 
              RowBox[{"[", "pos", "]"}], "]"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"eqsA", "=", 
            RowBox[{"Delete", "[", 
             RowBox[{"eqsA", ",", "pos"}], "]"}]}], ";", 
           RowBox[{"Continue", "[", "]"}], ";"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Aoptions", "=", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Cases", "[", 
             RowBox[{
              RowBox[{"vars", "[", 
               RowBox[{"[", "pos", "]"}], "]"}], ",", "_A"}], "]"}], "!=", 
            RowBox[{"{", "}"}]}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"Thread", "[", 
              RowBox[{
               RowBox[{"Cases", "[", 
                RowBox[{
                 RowBox[{"vars", "[", 
                  RowBox[{"[", "pos", "]"}], "]"}], ",", "_A"}], "]"}], "->", 
               "#"}], "]"}], "&"}], "/@", 
            RowBox[{"Tuples", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"1", ",", 
                RowBox[{"-", "1"}]}], "}"}], ",", 
              RowBox[{"Length", "@", 
               RowBox[{"Cases", "[", 
                RowBox[{
                 RowBox[{"vars", "[", 
                  RowBox[{"[", "pos", "]"}], "]"}], ",", "_A"}], "]"}]}]}], 
             "]"}]}], ",", "Nothing"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{"Bs", " ", "and", " ", "BBs", " ", "that", " ", "enter"}], 
         " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"Borbits", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"Cases", "[", 
            RowBox[{
             RowBox[{"vars", "[", 
              RowBox[{"[", "pos", "]"}], "]"}], ",", "_B"}], "]"}], "/.", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"B", "[", "k_", "]"}], ":>", "k"}], ",", 
             RowBox[{
              RowBox[{"BB", "[", "k_", "]"}], ":>", "k"}]}], "}"}]}], "//", 
          "DeleteDuplicates"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{"Combined", " ", "options"}], " ", "*)"}], 
        RowBox[{"numOpt", "=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"2", "^", 
            RowBox[{"Length", "[", 
             RowBox[{"Cases", "[", 
              RowBox[{
               RowBox[{"vars", "[", 
                RowBox[{"[", "pos", "]"}], "]"}], ",", "_A"}], "]"}], "]"}]}],
            ")"}], "*", 
          RowBox[{"(", 
           RowBox[{"Times", "@@", 
            RowBox[{"(", 
             RowBox[{"Length", "/@", 
              RowBox[{"(", 
               RowBox[{"Bcases", "/@", "Borbits"}], ")"}]}], ")"}]}], 
           ")"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"numOpt", ">", 
           RowBox[{"2", "^", "MaxVar"}]}], ",", 
          RowBox[{
           RowBox[{"AppendTo", "[", 
            RowBox[{"bckpeqs", ",", 
             RowBox[{"eqsA", "[", 
              RowBox[{"[", "pos", "]"}], "]"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"eqsA", "=", 
            RowBox[{"Delete", "[", 
             RowBox[{"eqsA", ",", "pos"}], "]"}]}], ";", 
           RowBox[{"Continue", "[", "]"}], ";"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"CombOptions", "=", 
         RowBox[{"Flatten", "/@", 
          RowBox[{"Tuples", "[", 
           RowBox[{"Join", "[", 
            RowBox[{
             RowBox[{"{", "Aoptions", "}"}], ",", 
             RowBox[{"Bcases", "/@", "Borbits"}]}], "]"}], "]"}]}]}], ";", 
        RowBox[{"(*", " ", 
         RowBox[{"Scan", " ", "through", " ", "them"}], " ", "*)"}], 
        RowBox[{"nowEq", "=", 
         RowBox[{"eqsA", "[", 
          RowBox[{"[", "pos", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"checks", "=", 
         RowBox[{
          RowBox[{"nowEq", "/.", "CombOptions"}], "//", "RootReduce"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{"Look", " ", "for", " ", "integers"}], " ", "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"integers", "=", 
         RowBox[{
          RowBox[{"Position", "[", 
           RowBox[{
            RowBox[{"IntegerQ", "/@", "checks"}], ",", "True"}], "]"}], "//", 
          "Flatten"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{"See", " ", "what", " ", 
          RowBox[{"A", "'"}], "s", " ", "have", " ", "been", " ", "fixed"}], 
         " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"result", "=", 
         RowBox[{"Apply", "[", 
          RowBox[{"Intersection", ",", 
           RowBox[{
            RowBox[{
             RowBox[{"CombOptions", "[", 
              RowBox[{"[", "#", "]"}], "]"}], "&"}], "/@", "integers"}]}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"result", "!=", 
           RowBox[{"{", "}"}]}], ",", 
          RowBox[{"(*", " ", 
           RowBox[{
            RowBox[{"If", " ", "some", " ", 
             RowBox[{"A", "'"}], "s", " ", "were", " ", "fixed", " ", "we", 
             " ", "save", " ", "the", " ", "result"}], "..."}], " ", "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"message", "=", 
            RowBox[{"ToString", "[", "result", "]"}]}], ";", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"fixedAs", ",", 
             RowBox[{"result", "/.", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{
                 RowBox[{"A", "[", "i_", "]"}], ":>", 
                 RowBox[{"a", "[", "i", "]"}]}], ",", 
                RowBox[{
                 RowBox[{"B", "[", "i_", "]"}], ":>", 
                 RowBox[{"b", "[", "i", "]"}]}], ",", 
                RowBox[{
                 RowBox[{"BB", "[", "i_", "]"}], ":>", 
                 RowBox[{"bb", "[", "i", "]"}]}]}], "}"}]}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"(*", " ", 
            RowBox[{"...", "and", " ", "replace", " ", "the", " ", "result"}],
             " ", "*)"}], "\[IndentingNewLine]", 
           RowBox[{"result", "/.", 
            RowBox[{"Rule", "->", "Set"}]}], ";"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{
           "Otherwise", " ", "we", " ", "keep", " ", "it", " ", "for", " ", 
            "later"}], " ", "*)"}], "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"AppendTo", "[", 
            RowBox[{"bckpeqs", ",", 
             RowBox[{"eqsA", "[", 
              RowBox[{"[", "pos", "]"}], "]"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"eqsA", "=", 
            RowBox[{"Delete", "[", 
             RowBox[{"eqsA", ",", "pos"}], "]"}]}], ";"}]}], "]"}]}]}], 
      "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[58]:=",ExpressionUUID->"cabb4904-2052-4754-8097-2eb2ce537c48"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ShuffleEqs", "[", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"eqsAtmp", "=", "eqsA"}], "}"}], ",", 
    RowBox[{
     RowBox[{"message", "=", "\"\<shuffling equations...\>\""}], ";", 
     RowBox[{"eqsA", "=", 
      RowBox[{"Join", "[", 
       RowBox[{"bckpeqs", ",", 
        RowBox[{"Select", "[", 
         RowBox[{"eqsAtmp", ",", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", 
             RowBox[{"Variables", "[", "#", "]"}], "]"}], ">", "0"}], "&"}]}],
          "]"}]}], "]"}]}], ";", 
     RowBox[{"constants", "=", 
      RowBox[{"Join", "[", 
       RowBox[{"constants", ",", 
        RowBox[{"Select", "[", 
         RowBox[{"eqsAtmp", ",", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", 
             RowBox[{"Variables", "[", "#", "]"}], "]"}], "==", "0"}], 
           "&"}]}], "]"}]}], "]"}]}], ";", 
     RowBox[{"bckpeqs", "=", 
      RowBox[{"{", "}"}]}]}]}], "]"}]}]], "Input",
 CellLabel->"In[59]:=",ExpressionUUID->"b7345d1c-f800-47c0-8397-44d8566c11c4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Study", "[", "func_", "]"}], ":=", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"dealtWith", "=", 
     RowBox[{"{", "}"}]}], ";", 
    RowBox[{"Monitor", "[", 
     RowBox[{
      RowBox[{"While", "[", 
       RowBox[{
        RowBox[{"toTry", "!=", 
         RowBox[{"{", "}"}]}], ",", 
        RowBox[{
         RowBox[{"g", "=", 
          RowBox[{"toTry", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ";", 
         RowBox[{"genEqsAB", "[", 
          RowBox[{"g", ",", "func"}], "]"}], ";", 
         RowBox[{"TryFixAB", "[", "]"}], ";", 
         RowBox[{"ShuffleEqs", "[", "]"}], ";", 
         RowBox[{"dealtWith", "=", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"dealtWith", ",", "g"}], "]"}]}]}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{
       "\"\<g:\>\"", ",", "g", ",", "message", ",", "\"\<Length[eqsA]\>\"", 
        ",", 
        RowBox[{"Length", "[", "eqsA", "]"}], ",", "\"\<Length[bckpeqs]\>\"", 
