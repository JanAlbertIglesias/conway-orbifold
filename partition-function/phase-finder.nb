 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"A", "[", "x_", "]"}], "/;", " ", 
    RowBox[{"x", "<=", " ", "218"}]}], ":=", "1"}], ";"}]], "Input",
 CellLabel->"In[46]:=",ExpressionUUID->"869e6e5d-2c45-432e-89cf-98a600cb033b"],

Cell["\<\
We will work with ZAlt, and later check integrality in other theories. Now \
ZAlt[g, \[Chi]] will be a linear combination of A\[CloseCurlyQuote]s. We want \
it to be integer for any g and \[Chi].\
\>", "Text",ExpressionUUID->"06a3d0b2-80c1-44ba-ab69-31c1122e3d7c"],

