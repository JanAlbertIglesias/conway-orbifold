         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"isVisited", " ", "=", " ", 
           RowBox[{"ConstantArray", "[", 
            RowBox[{"False", ",", "24"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"For", "[", 
           RowBox[{
            RowBox[{"i", "=", "1"}], ",", " ", 
            RowBox[{"i", "<=", "23"}], ",", " ", 
            RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"isVisited", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "==", "True"}], ",", " ", 
               RowBox[{"Continue", "[", "]"}]}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"blockdiag", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", ",", 
                   RowBox[{"i", "+", "1"}]}], "]"}], "]"}], "!=", "0"}], ",", 
               " ", 
               RowBox[{"(*", " ", 
                RowBox[{
                 RowBox[{"In", " ", "this", " ", "case"}], ",", " ", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"blockdiag", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "i"}], "]"}], "]"}], " ", "is", " ", 
                   "the", " ", "top", " ", "left", " ", "of", " ", "a", " ", 
                   "non"}], "-", 
                  RowBox[{
                  "diagonal", " ", "2", "\[Times]", "2", " ", "rotation", " ", 
                   RowBox[{"matrix", "."}]}]}]}], " ", "*)"}], 
               "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"columnsort", " ", "=", " ", 
                 RowBox[{"columnsort", " ", "~", "Join", "~", " ", 
                  RowBox[{"{", 
                   RowBox[{"i", ",", " ", 
                    RowBox[{"i", "+", "1"}]}], "}"}]}]}], ";", " ", 
                "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"isVisited", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], " ", "=", " ", "True"}], 
