          RowBox[{"All", ",", " ", "columnsort"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{"Extract", " ", "12", " ", "angles"}], " ", "*)"}], 
