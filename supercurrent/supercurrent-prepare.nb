                RowBox[{
                 RowBox[{"isVisited", "[", 
                  RowBox[{"[", 
                   RowBox[{"i", "+", "1"}], "]"}], "]"}], " ", "=", " ", 
                 "True"}], ";", "\[IndentingNewLine]", 
                RowBox[{"Continue", "[", "]"}]}]}], "\[IndentingNewLine]", 
              "]"}], ";", "\[IndentingNewLine]", 
             RowBox[{"(*", " ", 
              RowBox[{"Otherwise", ",", " ", 
               RowBox[{
               "we", " ", "have", " ", "to", " ", "find", " ", "j", " ", 
                "such", " ", "that", " ", 
                RowBox[{"blockdiag", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", ",", "i"}], "]"}], "]"}], " ", "and", " ", 
                RowBox[{"blockdiag", "[", 
                 RowBox[{"[", 
                  RowBox[{"j", ",", "j"}], "]"}], "]"}], " ", "constitute", 
                " ", "a", " ", "diagonal", " ", "2", "\[Times]", "2", " ", 
                "rotation", " ", 
                RowBox[{"matrix", "."}]}]}], " ", "*)"}], 
             "\[IndentingNewLine]", 
             RowBox[{"For", "[", 
              RowBox[{
               RowBox[{"j", "=", 
