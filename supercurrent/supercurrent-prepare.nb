          "eigenmat"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{"Check", " ", "there", " ", "is", " ", "no", " ", 
         RowBox[{"(", GridBox[{
            {"cos\[Theta]", "sin\[Theta]"},
