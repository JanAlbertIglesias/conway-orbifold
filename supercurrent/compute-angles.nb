Cell[BoxData[
 RowBox[{
  RowBox[{"DiagonalizeWithEigenMat", "[", 
   RowBox[{"a_", ",", "b_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "aortho", ",", " ", "bortho", ",", "eigenmat", ",", "blockdiag", ",", 
      "columnsort", ",", " ", "adiag", ",", " ", "bdiag", ",", " ", 
      "angles"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{"Check", " ", "if", " ", "they", " ", "commute"}], " ", "*)"}], 
    "\[IndentingNewLine]", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Length", "[", 
        RowBox[{"DeleteCases", "[", 
         RowBox[{
          RowBox[{"Flatten", "[", 
           RowBox[{
            RowBox[{"a", ".", "b"}], "-", 
            RowBox[{"b", ".", "a"}]}], "]"}], ",", "0"}], "]"}], "]"}], ">", 
       "0"}], ",", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{"Print", "[", "\"\<Do not commute!\>\"", "]"}], ";"}], "*)"}],
       " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "We", " ", "need", " ", "unitary", " ", "diagonalization", " ", 
        "matrix"}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{"To", " ", "obtain", " ", "it"}], ",", " ", 
        RowBox[{
        "we", " ", "make", " ", "a", " ", "and", " ", "b", " ", "normal", " ",
          "matrices", " ", 
         RowBox[{"(", 
          RowBox[{"in", " ", "SO", 
           RowBox[{"(", "24", ")"}]}], ")"}]}], ",", " ", 
        RowBox[{"and", " ", "perform", " ", "Schur", " ", "decomposition"}]}],
        " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"aortho", " ", "=", " ", 
        RowBox[{"W", ".", "a", ".", 
         RowBox[{"Inverse", "[", "W", "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"bortho", " ", "=", " ", 
        RowBox[{"W", ".", "b", ".", 
         RowBox[{"Inverse", "[", "W", "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"eigenmat", ",", "blockdiag"}], "}"}], "=", 
        RowBox[{"SchurDecomposition", "[", 
         RowBox[{"N", "[", 
          RowBox[{"aortho", "+", 
           RowBox[{"\[Pi]", " ", "bortho"}]}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "Sort", " ", "columns", " ", "to", " ", "merge", " ", "spearated", 
         " ", "1", "\[Times]", "1", " ", "matrices", " ", "into", " ", "2", 
         "\[Times]", "2", " ", "diagonal", " ", "rotation", " ", "matrix"}], 
        " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"columnsort", " ", "=", " ", 
        RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"blockdiag", " ", "=", " ", 
        RowBox[{"Chop", "[", "blockdiag", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"isVisited", ",", " ", "i", ",", " ", "j"}], "}"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"isVisited", " ", "=", " ", 
           RowBox[{"ConstantArray", "[", 
            RowBox[{"False", ",", "24"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"For", "[", 
           RowBox[{
            RowBox[{"i", "=", "1"}], ",", " ", 
            RowBox[{"i", "<=", "23"}], ",", " ", 
            RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"isVisited", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "==", "True"}], ",", " ", 
               RowBox[{"Continue", "[", "]"}]}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"blockdiag", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", ",", 
