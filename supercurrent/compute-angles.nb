               " ", 
               RowBox[{"(*", " ", 
                RowBox[{
                 RowBox[{"In", " ", "this", " ", "case"}], ",", " ", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"blockdiag", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "i"}], "]"}], "]"}], " ", "is", " ", 
                   "the", " ", "top", " ", "left", " ", "of", " ", "a", " ", 
                   "non"}], "-", 
                  RowBox[{
                  "diagonal", " ", "2", "\[Times]", "2", " ", "rotation", " ", 
                   RowBox[{"matrix", "."}]}]}]}], " ", "*)"}], 
               "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"columnsort", " ", "=", " ", 
                 RowBox[{"columnsort", " ", "~", "Join", "~", " ", 
                  RowBox[{"{", 
                   RowBox[{"i", ",", " ", 
                    RowBox[{"i", "+", "1"}]}], "}"}]}]}], ";", " ", 
                "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"isVisited", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], " ", "=", " ", "True"}], 
                ";", " ", 
                RowBox[{
                 RowBox[{"isVisited", "[", 
                  RowBox[{"[", 
                   RowBox[{"i", "+", "1"}], "]"}], "]"}], " ", "=", " ", 
                 "True"}], ";", "\[IndentingNewLine]", 
                RowBox[{"Continue", "[", "]"}]}]}], "\[IndentingNewLine]", 
              "]"}], ";", "\[IndentingNewLine]", 
             RowBox[{"(*", " ", 
              RowBox[{"Otherwise", ",", " ", 
               RowBox[{
               "we", " ", "have", " ", "to", " ", "find", " ", "j", " ", 
                "such", " ", "that", " ", 
                RowBox[{"blockdiag", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", ",", "i"}], "]"}], "]"}], " ", "and", " ", 
                RowBox[{"blockdiag", "[", 
                 RowBox[{"[", 
                  RowBox[{"j", ",", "j"}], "]"}], "]"}], " ", "constitute", 
                " ", "a", " ", "diagonal", " ", "2", "\[Times]", "2", " ", 
                "rotation", " ", 
                RowBox[{"matrix", "."}]}]}], " ", "*)"}], 
             "\[IndentingNewLine]", 
             RowBox[{"For", "[", 
              RowBox[{
               RowBox[{"j", "=", 
                RowBox[{"i", "+", "1"}]}], ",", 
               RowBox[{"j", "<=", "24"}], ",", 
               RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"isVisited", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "==", "True"}], ",", " ", 
                  
                  RowBox[{"Continue", "[", "]"}]}], "]"}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{
                    RowBox[{"Chop", "[", 
                    RowBox[{
                    RowBox[{"blockdiag", "[", 
                    RowBox[{"[", 
                    RowBox[{"j", ",", "j"}], "]"}], "]"}], "-", 
                    RowBox[{"blockdiag", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "i"}], "]"}], "]"}]}], "]"}], "==", 
                    "0"}], " ", "&&", " ", 
                   RowBox[{
                    RowBox[{"blockdiag", "[", 
                    RowBox[{"[", 
                    RowBox[{"j", ",", " ", 
                    RowBox[{
                    RowBox[{"Mod", "[", 
                    RowBox[{"j", ",", "24"}], "]"}], "+", "1"}]}], "]"}], 
                    "]"}], "==", "0"}]}], ",", "\[IndentingNewLine]", 
                  RowBox[{
                   RowBox[{"columnsort", " ", "=", " ", 
                    RowBox[{"columnsort", " ", "~", "Join", "~", " ", 
                    RowBox[{"{", 
