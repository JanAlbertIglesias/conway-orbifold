 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "For", " ", "a", " ", "given", " ", "list", " ", "of", " ", "commuting", 
     " ", "pairs"}], ",", 
    RowBox[{
     RowBox[{
     "export", " ", "their", " ", "angles", " ", "and", " ", "block"}], "-", 
     RowBox[{
     "diagonalization", " ", "matrices", " ", "to", " ", "pass", " ", "to", 
      " ", 
      RowBox[{"C", "++"}]}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ExportAngleAndEigenmat", "[", 
     RowBox[{"CommutingPairList_", ",", " ", "FileName_"}], "]"}], " ", ":=", 
    "\[IndentingNewLine]", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "stream", ",", " ", "i", ",", " ", "angles", ",", " ", "eigenmat"}], 
       "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"stream", "=", 
        RowBox[{"OpenAppend", "[", "FileName", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"WriteString", "[", 
        RowBox[{"stream", ",", " ", 
         RowBox[{"Length", "[", "CommutingPairList", "]"}], ",", " ", 
         "\"\<\\n\>\""}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"i", "=", "1"}], ",", " ", 
         RowBox[{"i", "<=", " ", 
          RowBox[{"Length", "[", "CommutingPairList", "]"}]}], ",", " ", 
         RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"angles", ",", " ", "eigenmat"}], "}"}], " ", "=", " ", 
           RowBox[{"DiagonalizeWithEigenMat", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"CommutingPairList", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
             RowBox[{
              RowBox[{"CommutingPairList", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"angles", " ", "==", " ", "0"}], ",", " ", 
            RowBox[{
             RowBox[{"Print", "[", 
              RowBox[{"i", ",", " ", "\"\<-th pair does not commute!\>\""}], 
              "]"}], ";", 
             RowBox[{"Continue", "[", "]"}]}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{
            RowBox[{
            "\"\<Export\>\"", " ", "preserves", " ", "the", " ", 
             "precision"}], ",", " ", 
            RowBox[{
            "but", " ", "\"\<WriteString\>\"", " ", "rounds", " ", "the", " ",
              "value"}], ",", " ", 
            RowBox[{"so", " ", "we", " ", "need", " ", 
             RowBox[{"\"\<ToString[CForm[x]]\>\"", "."}]}]}], " ", "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{"WriteString", "[", 
           RowBox[{"stream", ",", 
            RowBox[{
             RowBox[{"StringRiffle", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"N", "[", 
                 RowBox[{"angles", "[", 
                  RowBox[{"[", 
                   RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}], "/.", " ", 
                
                RowBox[{"x_Real", ":>", 
                 RowBox[{"ToString", "[", 
                  RowBox[{"CForm", "[", "x", "]"}], "]"}]}]}], ",", 
               "\"\< \>\""}], "]"}], "<>", "\"\<\\n\>\""}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"WriteString", "[", 
           RowBox[{"stream", ",", 
            RowBox[{
             RowBox[{"StringRiffle", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"N", "[", 
                 RowBox[{"angles", "[", 
                  RowBox[{"[", 
                   RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}], "/.", " ", 
                
                RowBox[{"x_Real", ":>", 
                 RowBox[{"ToString", "[", 
